# =============================================================
# ONBOARDING environment — for a NEW society deployment.
# Copy to onboarding/.env and fill in real values:
#   cp onboarding/.env.example onboarding/.env
# Then:
#   docker compose -f onboarding/docker-compose.yml --env-file onboarding/.env up -d
# =============================================================

# ---- Domain (SINGLE SOURCE OF TRUTH — set this ONE value) ----
# Drives: nginx server_name + TLS cert paths, APP_BASE_URL, FRONTEND_URL, and the
# Cashfree callback URLs. No other URL needs editing, and no image rebuild is
# needed to re-point the stack to a different domain.
DOMAIN=yourdomain.in
# Optional; defaults to www.$DOMAIN if left blank.
DOMAIN_WWW=

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=ChangeThisStrongRootPassword
DB_USERNAME=society_app
DB_PASSWORD=ChangeThisAppDbPassword

# ---- Security (REQUIRED) ----
# Long random string (>= 64 chars). Generate: openssl rand -base64 48
JWT_SECRET=ChangeThisToASecureRandomStringAtLeast64CharsLong_abc123xyz789

# ---- Email (Gmail SMTP — OTP + password reset) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_society_gmail@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# ---- Razorpay (member portal) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Cashfree (optional; return/notify URLs auto-derived from DOMAIN) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=production

# ---- Firebase Cloud Messaging (optional, free push) ----
# Leave false to run on in-app polling. To enable: set true + project id and put
# the service-account JSON at onboarding/secrets/fcm-service-account.json.
FCM_ENABLED=false
FCM_PROJECT_ID=
VISITOR_EXPIRY_SCAN_MS=60000
VISITOR_REPUSH_MS=10000

# ---- Application URLs ----
# Admin SPA is served at the site root, so keep this EMPTY (keeps reset-email
# links pointing at https://$DOMAIN/... ). APP_BASE_URL / FRONTEND_URL are
# derived from DOMAIN in onboarding/docker-compose.yml — do not set them here.
FRONTEND_BASE_PATH=
