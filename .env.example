# =============================================================
# Production environment for docker-compose
# Copy to .env and fill in real values:  cp .env.example .env
# =============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=ChangeThisStrongRootPassword
DB_USERNAME=society_app
DB_PASSWORD=ChangeThisAppDbPassword

# ---- Security ----
# Must be a long random string (>= 64 chars). REQUIRED — compose will refuse to start without it.
JWT_SECRET=ChangeThisToASecureRandomStringAtLeast64CharsLong_abc123xyz789

# ---- Email (Gmail SMTP — Forgot Password & OTP delivery) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ppvsociety.cdwing@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# ---- Cashfree Payment Gateway ----
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=production
CASHFREE_RETURN_URL=https://ppvcd.in/maintenance/payment-status
CASHFREE_NOTIFY_URL=https://ppvcd.in/api/member/payments/webhook/cashfree

# ---- Razorpay Payment Gateway (Member Portal) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Firebase Cloud Messaging (visitor/delivery push — OPTIONAL, free) ----
# Leave FCM_ENABLED=false to run without push (the gate flow falls back to in-app
# polling). To enable: set true, add the project id, and place the service-account
# JSON at ./secrets/fcm-service-account.json (see secrets/README.md).
FCM_ENABLED=false
FCM_PROJECT_ID=
# How often the backend scans for expired PENDING visitor requests (ms).
VISITOR_EXPIRY_SCAN_MS=60000
# How often a still-pending visitor request re-pushes its notification so the owner
# keeps being alerted until they act or it times out (ms). Default: every 10 seconds.
VISITOR_REPUSH_MS=10000

# ---- Application URLs ----
APP_BASE_URL=https://ppvcd.in/api
FRONTEND_URL=https://ppvcd.in
# Admin SPA is served at the site root now, so this stays EMPTY.
FRONTEND_BASE_PATH=
