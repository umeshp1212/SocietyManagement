{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "admin-portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "root": "projects/admin-portal",
      "sourceRoot": "projects/admin-portal/src",
      "prefix": "admin",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin-portal",
            "index": "projects/admin-portal/src/index.html",
            "browser": "projects/admin-portal/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/admin-portal/tsconfig.app.json",
            "assets": [
              "projects/admin-portal/src/favicon.ico",
              "projects/admin-portal/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/admin-portal/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "baseHref": "/",
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" },
                { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/admin-portal/src/environments/environment.ts",
                  "with": "projects/admin-portal/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "admin-portal:build:production" },
            "development": { "buildTarget": "admin-portal:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/admin-portal/tsconfig.spec.json",
            "karmaConfig": "projects/admin-portal/karma.conf.js",
            "assets": [
              "projects/admin-portal/src/favicon.ico", 
              "projects/admin-portal/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/admin-portal/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "member-portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "root": "projects/member-portal",
      "sourceRoot": "projects/member-portal/src",
      "prefix": "member",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/member-portal",
            "index": "projects/member-portal/src/index.html",
            "browser": "projects/member-portal/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/member-portal/tsconfig.app.json",
            "assets": [
              "projects/member-portal/src/favicon.ico",
              "projects/member-portal/src/assets",
              "projects/member-portal/src/manifest.json"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/member-portal/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "baseHref": "/member/",
              "serviceWorker": "projects/member-portal/ngsw-config.json",
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" },
                { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/member-portal/src/environments/environment.ts",
                  "with": "projects/member-portal/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "member-portal:build:production" },
            "development": { "buildTarget": "member-portal:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/member-portal/tsconfig.spec.json",
            "karmaConfig": "projects/member-portal/karma.conf.js",
            "assets": [
              "projects/member-portal/src/favicon.ico",
              "projects/member-portal/src/assets",
              "projects/member-portal/src/manifest.json"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/member-portal/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "38498fa8-dda3-4925-9147-ac380e685b44"
  }
}