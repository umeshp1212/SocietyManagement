{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "baseUrl": ".",
    "types": [
      "jasmine"
    ],
    "paths": {
      "@core/*": ["src/app/core/*"],
      "@env/*": ["src/environments/*"]
    }
  },
